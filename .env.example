# Required in every deployment. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# local_invite for public/self-hosted instances; authentik only behind a trusted
# reverse proxy that injects and strips the Authentik identity headers.
AUTH_MODE=local_invite
TRUST_AUTHENTIK_HEADERS=false
AUTHENTIK_REQUIRED_GROUPS=members

# Set false only for local HTTP development. Production must use HTTPS.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_DOMAIN=
CORS_ORIGINS=

# Runtime state lives outside the source checkout in production.
DB_PATH=./data/aetherchat.db
OUTPUT_DIR=./data/output
VOICE_SAMPLE_DIR=./data/private/voice-samples

# OpenAI-compatible private providers. Browser clients never reach these directly.
LLM_API_BASE=http://127.0.0.1:5000
LLM_API_KEY=
TTS_API_BASE=http://127.0.0.1:8000
TTS_API_KEY=
TTS_ACCELERATOR_CONTROLLER_URL=
TTS_DEFAULT_VOICE=default

# Deliberately disabled pending separate repair/implementation work.
VIDEO_ENABLED_DEFAULT=false
STORY_ENABLED_DEFAULT=false
